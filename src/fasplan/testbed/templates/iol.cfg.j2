! generated by fasplan: {{ hostname }} ({{ role }}{% if building %}, {{ building }}{% endif %}), strategy={{ strategy }}, protocol={{ protocol }}
hostname {{ hostname }}
no ip domain lookup
!
interface Loopback0
 ip address {{ router_id }} 255.255.255.255
 bandwidth 1000000
 delay 1
!
{% for i in interfaces %}
interface {{ i.name }}
 description {{ i.desc }}
 ip address {{ i.ip }} {{ i.mask }}
 bandwidth 1000000
 delay {{ i.delay }}
{% if protocol == 'ospf' %}
 ip ospf network point-to-point
{% if i.kind == 'p2p' %}
 ip ospf cost {{ i.cost }}
 ip ospf hello-interval {{ hello }}
 ip ospf dead-interval {{ dead }}
{% endif %}
{% elif i.kind == 'p2p' %}
 ip hello-interval eigrp {{ eigrp_as }} {{ hello }}
 ip hold-time eigrp {{ eigrp_as }} {{ dead }}
{% for s in i.summaries %}
 ip summary-address eigrp {{ eigrp_as }} {{ s.network }} {{ s.mask }}
{% endfor %}
{% endif %}
 no shutdown
!
{% endfor %}
{% if protocol == 'ospf' %}
router ospf 1
 router-id {{ router_id }}
 network {{ router_id }} 0.0.0.0 area {{ loopback_area }}
{% for i in interfaces %}
 network {{ i.ip }} 0.0.0.0 area {{ i.area }}
{% endfor %}
{% for i in interfaces if i.passive %}
 passive-interface {{ i.name }}
{% endfor %}
{% for r in ospf_ranges %}
 area {{ r.area }} range {{ r.network }} {{ r.mask }}
{% endfor %}
{% else %}
router eigrp {{ eigrp_as }}
 eigrp router-id {{ router_id }}
 no auto-summary
 network {{ router_id }} 0.0.0.0
{% for i in interfaces %}
 network {{ i.ip }} 0.0.0.0
{% endfor %}
{% for i in interfaces if i.kind == 'probe' %}
 passive-interface {{ i.name }}
{% endfor %}
{% endif %}
!
