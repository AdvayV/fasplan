! generated by fasplan: {{ hostname }} ({{ role }}{% if building %}, {{ building }}{% endif %}), strategy={{ strategy }}
frr defaults traditional
hostname {{ hostname }}
log syslog informational
service integrated-vtysh-config
!
interface lo
 ip address {{ router_id }}/32
 ip ospf area {{ loopback_area }}
exit
!
{% for i in interfaces %}
interface {{ i.name }}
 description {{ i.desc }}
 ip address {{ i.ip }}/{{ i.prefixlen }}
 ip ospf area {{ i.area }}
{% if i.kind == 'p2p' %}
 ip ospf network point-to-point
 ip ospf cost {{ i.cost }}
 ip ospf hello-interval {{ hello }}
 ip ospf dead-interval {{ dead }}
{% endif %}
exit
!
{% endfor %}
router ospf
 ospf router-id {{ router_id }}
 passive-interface lo
{% for i in interfaces if i.passive %}
 passive-interface {{ i.name }}
{% endfor %}
{% for r in ospf_ranges %}
 area {{ r.area }} range {{ r.prefix }}
{% endfor %}
exit
!
